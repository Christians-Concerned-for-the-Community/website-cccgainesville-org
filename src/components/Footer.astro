---
import Button from '@base/Button.astro';
import DarkModeToggle from '@base/DarkModeToggle.astro';
import Icon from '@base/Icon.astro';
import type { NavIcon } from '@base/Nav.astro';

import socials from '@/assets/socials.json'

/**
 * Footer Component
 *
 * @description A component that displays the footer of the website
 */
const currentYear = new Date().getFullYear();
const navIcons = socials as NavIcon[];
---

<footer id="footer" class="flex flex-col items-center text-lg py-md border-t border-muted not-dark:bg-gray-100">
  <section class:list={[
    "flex max-w-(--content-max) w-full items-center justify-center sm:flex-wrap-reverse sm:justify-around",
    "px-3xs 2xs:px-sm-md gap-x-[3ch] gap-y-[0.8em]"
  ]}>
    <div class="flex flex-wrap justify-center items-center w-full gap-x-xs gap-y-3xs">
      <div>&copy; {currentYear}</div>
      <div class="flex flex-wrap justify-center items-center gap-x-xs gap-y-3xs">
        <Icon name="local:ccc-logo" size="1lh"/>
        Christians Concerned for the Community
      </div>
    </div>
    <div class="hidden sm:flex items-center gap-sm">
      {navIcons.map((item) => (
        <Button href={item.href} alt={item.alt} icon={item.icon}
                animation="rotate" variant="ghost"/>
      ))}
      <DarkModeToggle iconOff="tabler:sun" iconOn="tabler:moon"/>
    </div>
  </section>
  <slot />
</footer>
