---
/**
 * FormPick.astro
 *
 * A form field for picking one or multiple options from a list of choices.
 *
 *
 * TODO: implement checkbox/radio version of this, too, put it behind an option.
 */
import type { HTMLAttributes } from "astro/types";
import Icon from "./Icon.astro";
import { twMerge } from "tailwind-merge";
import { uniqueId } from "./utils/ids";

type Props = Omit<
  HTMLAttributes<"div">,
  "id" | "aria-describedby"
> & {
  /**
   * Whether to present the options as a select drop-down, or a list of
   * radio/checkbox buttons.
   * 
   * @default "select"
   */
  type?: "select" | "buttons",

  /**
   * Display name of the field, visible to the user.
   */
  label: string,

  /**
   * Internal name of the field, visible to code that processes form submissions.
   */
  name: string,

  /**
   * An object mapping option values to display labels.
   *
   * For example, if we want the user to see the options "Honda Accord"
   * and "Toyota Camry", and we want to submit the values "car_honda" and
   * "car_toyota" in the form data when each option is selected, we'd
   * set options as follows:
   *
   * {
   *  car_honda: "Honda Accord",
   *  car_toyota: "Toyota Camry"
   * }
   */
  options: Record<string,string>,

  /**
   * Additional classes to apply to the field label, which also acts
   * as a layout container for the field itself.
   */
  class?: string | string[],

  /**
   * Additional classes to apply to the form field itself.
   */
  fieldClass?: string | string[],

  /**
   * Additional classes to apply to the form field inline-error container.
   */
  errorClass?: string | string[],
} & (
  {
    /**
     * Are we allowed to select more than one choice?
     */
    multiple: true,
    /**
     * Provide the values that should be selected initially (if any).
     */
    startWith?: string | string[],
  }
  |
  {
    /**
     * Are we allowed to select more than one choice?
     */
    multiple?: false,
    /**
     * Provide the value that should be selected initially (if any).
     */
    startWith?: string,
  }
);

const {
  type = "select",
  label,
  name,
  options,
  startWith,
  multiple = false,
  class: className,
  fieldClass,
  errorClass,
  ...rest
} = Astro.props;

// Generate unique-per-page, sequentially-numbered id's for each form field,
// using the given prefix.
const inputId = uniqueId(Astro.url, `form-${name}`);
const errId = uniqueId(Astro.url, `form-${name}-err`);

type OptionWithId = {
  value: string,
  label: string,
  id: string,
}
let optionsIds: OptionWithId[] = [];
if (type==="buttons") {
  optionsIds = Object.entries(options).map(([value, label]) => {return {
    value: value,
    label: label,
    id: uniqueId(Astro.url, `form-${name}-${value}`),
  }});
}


const multipleVal = multiple? "true" : undefined;

// Convert starting values to array, filter out those that aren't present in the
// options list.
let defaults: string[] = [];
if (startWith) {
  defaults = (typeof startWith === "string"? [startWith] : startWith).filter(
    val => {
      const ret = Object.keys(options).includes(val);
      if (!ret) {
        console.warn(`FormPick - ${inputId} - requested default value ${val} is not in list of options.`);
      }
      return ret;
    }
  );
}

// If no default value was given and we're doing single selection, just use the
// first listed option.
if (defaults.length === 0 && !multiple) {
  defaults.push(Object.keys(options)[0]);
}

---

{type==="buttons" && (
<fieldset data-name={name} data-err={errId} class={twMerge(
  "base-form-field group/field has-aria-invalid:border-l-error-accent has-aria-invalid:border-l-3",
  "text-lg px-xs py-2xs w-full rounded-sm",
  className
)}>
  <legend class="float-left w-full">{label}</legend>

  {/* Error message. Always hide with aria-hidden, so that it's only read via aria-describedby. */}
  <div aria-hidden="true" class={twMerge(
    "hidden group-has-aria-invalid/field:block",
    "w-full text-sm text-error ms-[0.5em]",
    errorClass
  )}>
    <Icon name="tabler:alert-triangle" size="1lh" class="text-error me-[0.25em]"/>
    <span id={errId}></span>
  </div>

  <div class="flex flex-col w-full">
  { optionsIds.map( option => (
    <label for={option.id} class={twMerge(
      "base-focus-container w-full ps-xs pe-3xs py-2xs text-current/90 text-base cursor-pointer",
      fieldClass)}
    >
      <span class="flex justify-start items-start">
        <input id={option.id} type={multiple?"checkbox":"radio"} value={option.value} name={name}
          aria-describedby={errId}
          checked={defaults.includes(option.value)}
          class="shrink-0 me-2xs"
        />
        {option.label}
      </span>
    </label>
  ))}
  </div>
</fieldset>
)}


{type==="select" && (
<label for={inputId} class={twMerge(
  "group/field w-full px-xs py-2xs text-lg cursor-pointer rounded-sm",
  "has-aria-invalid:border-l-error-accent has-aria-invalid:border-l-3",
  className)}
>
  {/* Label text. */}
  {label}

  {/* Error message. Always hide with aria-hidden, so that it's only read via aria-describedby. */}
  <div aria-hidden="true" class={twMerge(
    "hidden group-has-aria-invalid/field:block",
    "w-full text-sm text-error ms-[0.5em]",
    errorClass
  )}>
    <Icon name="tabler:alert-triangle" size="1lh" class="text-error me-[0.25em]"/>
    <span id={errId}></span>
  </div>

  {/* Select box. */}
  <div class={twMerge("base-focus-container text-current/90 text-base", fieldClass)}>
    <select id={inputId} name={name} data-name={name} multiple={multipleVal}
      aria-describedby={errId} data-err={errId} class="base-form-field",
      {...rest}
    >
      { Object.entries(options).map(([value, label]) => (
        <option value={value} selected={defaults.includes(value)}>{label}</option>
      ))}
    </select>
  </div>
</label>
)}
