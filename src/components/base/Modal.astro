---
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";
import { twMerge } from 'tailwind-merge'

import Button from "./Button.astro";
import { uniqueId } from "./utils/ids";

const modalId = uniqueId(Astro.url, "base-modal");

type Props =
 Omit<HTMLAttributes<"dialog">, "closedby"> &
 Pick<VariantProps<typeof Button>,
    "variant" | "animation" | "label" | "iconBefore" | "icon" | "iconClass"> &
{
  /**
   * Where on the page does the modal open?
   */
  location?: "top" | "right" | "bottom" | "left" | "center";

  /**
   * Additional classes to apply to the container that holds the trigger
   * button and the dialog.
   */
  containerClass?: string | string[];

  /**
   * Additional classes to apply to the trigger button.
   */
  buttonClass?: string | string[];

  /**
   * Additional classes to apply to the close button.
   */
  closeClass?: string | string[];

  /**
   * Icon to use for close button.
   *
   * @default: tabler:x
   */
  closeIcon?: string;
}

const {
  location,
  containerClass,
  buttonClass,
  closeClass,
  closeIcon = "tabler:x",
  class: className,
  variant = "default",
  animation,
  label,
  iconBefore,
  icon,
  iconClass,
  ...rest
} = Astro.props;

const dialogVariants = tv({
  base: [
    "open:flex overflow-y-auto scrollbar-gutter-auto",
    "bg-background shadow-lg max-w-cw-md p-0 m-0",
  ],
  variants: {
    location: {
      center: ["rounded-lg",
        "top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2",
      ],
      right: ["rounded-l-lg base-right",
        "inset-y-0 right-0 left-auto h-full max-h-svh w-3/4 sm:max-w-cw-sm",
      ],
      left: ["rounded-r-lg base-left",
        "inset-y-0 right-auto left-0 h-full max-h-svh w-3/4 sm:max-w-cw-sm",
      ],
      top: ["rounded-b-lg base-top",
        "inset-x-0 top-0 bottom-auto h-auto w-full max-w-svw",
      ],
      bottom: ["rounded-t-lg base-bottom",
        "inset-x-0 top-auto bottom-0 h-auto w-full max-w-svw",
      ],
    }
  },
  defaultVariants: {
    location: "center",
  }
});

const closeDefault = "base-modal-close absolute top-xs right-sm text-sm";

---
<div class={twMerge("base-modal h-full", containerClass)}>
  <Button type="button" commandfor={modalId} command="show-modal"
    label={label}
    variant={variant}
    animation={animation}
    icon={icon}
    iconBefore={iconBefore}
    iconClass={iconClass}
    class={twMerge("[&_svg]:pointer-events-none",buttonClass)}
  />
  {/* Explanation for why we're setting pointer-events-none on any svg's inside
    * the trigger button (see above).
    *
    * WebKit browsers (Safari, primarily) have a bug where they can trigger
    * decorations guarded by focus-visible: when opening a dialog with
    * a mouse click or touch. This is incorrect behavior - it should
    * be setting the focus, but it shouldn't be displaying a focus ring
    * unless the user triggered the dialog via keyboard.
    *
    * See here for mention of bug:
    * https://github.com/radix-ui/primitives/issues/2953
    * https://bugs.webkit.org/show_bug.cgi?id=247416
    */}

  <dialog id={modalId} closedby="any"
    class={dialogVariants({ location, class: className })} {...rest}
  >
    {/*
      This is a workaround to fix a 4 year old bug in Safari, where it triggers
      :focus-visible on modal open when the keyboard was not used to trigger
      the modal button. Setting pointer-events to none on the button's svg does
      not work around this issue.

      Webkit bug: https://bugs.webkit.org/show_bug.cgi?id=247416
    */}
    <div tabindex=-1 autofocus class="sr-only not-safari:hidden"/>

    <slot />

    <Button type="button" commandfor={modalId} command="request-close"
      alt="Close"
      variant="ghost"
      animation="rotate"
      icon={closeIcon}
      class={twMerge(closeDefault, closeClass)}
    />
  </dialog>

</div>

<style is:global> @layer base {
  .base-modal > dialog {
    display: none;

    --base-open-duration: 500ms;
    --base-close-duration: 300ms;

    --base-transform: none;
    @media (prefers-reduced-motion: no-preference) {
      &.base-right { --base-transform: translateX(100%); }
      &.base-left {  --base-transform: translateX(-100%); }
      &.base-top {   --base-transform: translateY(-100%); }
      &.base-bottom {--base-transform: translateY(100%); }
    }
    
    /* Common transition properties. */
    transition-property: transform, opacity,  display,        overlay;
    transition-behavior: normal,    normal,   allow-discrete, allow-discrete;
    transition-timing-function: ease-out;
    overscroll-behavior: contain;
    &::backdrop {
      transition-property:        background-color, backdrop-filter, display,        overlay;
      transition-behavior:        normal,           normal,          allow-discrete, allow-discrete;
      transition-timing-function: ease-out;
      overflow: hidden;
      overscroll-behavior: contain;
    }

    /* Step #3: on the way out */
    &:not([open]),
    &.base-is-closing {
      opacity: 0;
      transition-duration: var(--base-close-duration);
      transform: var(--base-transform);

      &::backdrop {
        background-color: transparent;
        backdrop-filter: blur(0px);
        transition-duration: var(--base-close-duration);
      }
    }

    /* Step #2: open */
    &[open]:not(.base-is-closing) {
      opacity: 1;
      transition-duration: var(--base-open-duration);

      &::backdrop {
        background-color: rgba(0 0 0 0.55);
        backdrop-filter: blur(8px);
        transition-duration: var(--base-open-duration);
      }

      /* Step #1: on the way in */
      @starting-style {
        opacity: 0;
        transform: var(--base-transform);

        &::backdrop {
          background-color: transparent;
          backdrop-filter: blur(0px);
        }
      }
    }
  }
} </style>

<script>
{
  /* Fallback: closedBy isn't supported in Safari, and other browsers are baseline July 2025.

    At one point, Safari added the attribute without implementing it (arggh), so in order
    to accurately detect if it's unsupported, we have to make a dummy dialog and then check
    to see if the attribute's default value got set properly.
  */
  const supports_closedby = (document.createElement("dialog") as any).closedBy === "none";

  // Fallback: Invoker Commands API is supported everywhere in baseline Dec 2025.
  const supports_invoker = (Object.hasOwn(HTMLButtonElement.prototype, 'command'));

  const isSafari = document.documentElement.classList.contains("safari");

  // If fallback needed:
  if (!supports_invoker || !supports_closedby || isSafari) {
    // Loop over each modal container on the page.
    document.querySelectorAll<HTMLElement>(".base-modal").forEach((container) => {
      const trigger = container.querySelector('button');
      const dialog = container.querySelector('dialog');

      // Safari closes the dialog immediately, even if there are still CSS transitions pending.
      // To fix exit transition animations, trigger them with an extra class, then only close the
      // dialog once the transition is done.
      const close = () => {
        if (isSafari) {
          // Add listener for end of closing animation, that actually closes the dialog.
          dialog?.addEventListener("transitionend", () => {
            dialog.close();
            dialog.classList.remove("base-is-closing");
          }, { once: true });
          // Trigger closing animation.
          dialog?.classList.add("base-is-closing");
        } else {
          dialog?.close();
        }
      };
      if (isSafari) {
        // Intercept escape key, back button, or requestClose(), and use our custom closeDialog function
        // instead.
        dialog?.addEventListener("cancel", (e) => {
          e.preventDefault();
          close();
        });
      }

      if (!supports_closedby && dialog) {
        // Support "light dismiss" of modal (clicking outside it), if closedby attribute isn't available.
        dialog.addEventListener('click', (e) => {
          const edges = dialog.getBoundingClientRect();
          if (e.clientX < edges.left || e.clientX > edges.right ||
              e.clientY < edges.top  || e.clientY > edges.bottom) {
            e.stopPropagation(); //only close the innermost dialog on each click outside.
            close();
          }
        });
      }

      if (!supports_invoker && trigger && dialog) {
        const closer = dialog.querySelector<HTMLButtonElement>('.base-modal-close');
        for (const button of  [trigger, closer]) {
          button?.removeAttribute('command');
          button?.removeAttribute('commandfor');
        }

        trigger.ariaHasPopup = "dialog";
        trigger.addEventListener("click", () => { dialog.showModal(); });
        closer?.addEventListener('click', () => { close() });
      }
    });
  } // END if fallback needed
}
</script>
