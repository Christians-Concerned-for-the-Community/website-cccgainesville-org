---
import type { HTMLAttributes, ComponentProps } from "astro/types";
import {actions, getActionPath} from "astro:actions";
import { twMerge } from 'tailwind-merge';

import Button from "./Button.astro";
import Icon from "./Icon.astro";
import Spinner from "./Spinner.astro";
import FormInput from "./FormInput.astro";
import {
  captchaImpl,
  captchaComponent as Captcha,
} from './captcha.ts';

//Allow pages that use Form to connect to our own endpoints, to handle the
//form submissions.
Astro.csp?.insertDirective("connect-src 'self'");

type Props = HTMLAttributes<"form"> & {
  /**
   * Properties to style the submit button.
   * 
   * Be cautious about changing the button label to something other than
   * "submit". Non-sighted users may be confused by non-standard submit
   * button labels, because they don't perceive the visual cues (color and
   * placement within the form) that help sighted users understand what the
   * button really does.
   * 
   * See: https://plousia.com/blog/accessible-wording-form-submit-buttons
   * 
   * @default {label: "submit"}
   */
  submitButton?: Omit<ComponentProps<typeof Button>, "type">;

  /**
   * Name of action to send form results to for validation.
   */
  handlerAction: string,

  /**
   * Tag to use for the heading in the message box at the top of the form.
   * 
   * @default "h3"
   */
  messageHeadingTag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "div",

  /**
   * Heading text for the error summary.
   * 
   * @default "Oops, let's fix these errors first:"
   */
  errorHeadingText?: string,

  /**
   * Heading text for the success message.
   * 
   * @default "Successfully submitted!"
   */
  successHeadingText?: string,

  /**
   * Text to display in submit button during form initialization.
   * 
   * @default "Loading"
   */
  loadingText?: string,

  /**
   * Text to display in submit button during submission.
   * 
   * @default "Processing"
   */
  processingText?: string,
};

const {
  submitButton = {},
  handlerAction,
  messageHeadingTag : HeadTag = "h3",
  errorHeadingText = "Oops, let's fix these errors first:",
  successHeadingText = "Successfully submitted!",
  loadingText = "Loading",
  processingText = "Processing",
  class: className,
  ...rest
} = Astro.props;

if(!submitButton.label && !submitButton.icon && !submitButton.iconBefore) {
  submitButton.label = "Submit";
}
submitButton.class = twMerge(
  "base-form-submit text-lg min-w-[50%] mt-md",
  // Hide the primary button label during processing, and show the secondary label instead.
  "aria-disabled:opacity-90 aria-disabled:cursor-progress",
  submitButton.class
);

const actionUrl = getActionPath(actions[handlerAction]);
---

{/*
  States: initial, success, error
*/}
<form novalidate data-action={actionUrl} data-state="initial"
  class={twMerge(
    "base-form group/form flex flex-col items-center max-w-[60ch]",
    "p-sm border-t-foreground border-t-2 rounded-sm shadow-md dark:border-muted dark:border-2",
    className
  )}
  {...rest}
>
  <section tabindex="-1" class:list={[
    "hidden not-group-data-[state=initial]/form:block",
    "w-full p-[1em] rounded-sm border-3",
    "group-data-[state=error]/form:border-error-accent",
    "group-data-[state=success]/form:border-success-accent",
  ]}>
    {/* Error message display. */}
    <div class="hidden group-data-[state=error]/form:block text text-base">
      <HeadTag class="text-lg font-medium mbe-[0.8em]">
        <Icon name="tabler:alert-triangle" size="1lh" class="text-error me-[0.25em]"/>
        {errorHeadingText}
      </HeadTag>
      <ul></ul>
    </div>

    {/* Success message display. */}
    <div class="hidden group-data-[state=success]/form:block text text-base">
      <HeadTag class="text-lg font-medium mbe-[0.8em]">
        <Icon name="tabler:circle-check" size="1lh" class="text-success me-[0.25em]"/>
        {successHeadingText}
      </HeadTag>
      <slot name="success"/>
    </div>
  </section>

  {/* Honeypot. Lots of spam will still make it past this, but it's a cheap way to
      reduce the number of calls we need to make to captcha API's on the backend. */}
  <FormInput type="text" label="Approver Email" name="approver-email" class="reqd" value="jsmith@example.com" required/>

  <slot />

  <Captcha />

  <Button type="submit" aria-disabled="true" data-state="loading" {...submitButton}>
    <Fragment slot="label-secondary">
      <span class="hidden group-data-[state=loading]/button:inline">{loadingText}</span>
      <span class="hidden group-data-[state=submitting]/button:inline">{processingText}</span>
      <Spinner class="hidden group-data-state/button:inline size-[1lh] ms-[1em]"/>
    </Fragment>
  </Button>

  { !captchaImpl.everyPage && captchaImpl.attribution && (
    <div class="font-light text-current/90 text-[90%]">
      {captchaImpl.attribution}
    </div>
  )}
</form>

<script>
{ 
  document.querySelectorAll<HTMLFormElement>(".base-form").forEach((form) => {
    const msgContainer = form.querySelector<HTMLElement>('section');
    const errList = msgContainer?.querySelector<HTMLUListElement>('ul');
    const fields = form.querySelectorAll<HTMLElement>('.base-form-field');
    const submitButton = form.querySelector<HTMLButtonElement>('.base-form-submit');

    // On page load, pre-fill any single field values passed via URL query params.
    const params = new URLSearchParams(window.location.search);
    for (const el of fields) {
      const val = el.dataset.name? params.get(el.dataset.name) : null;
      if (val == null) continue; // skip if null or undefined, keep going if empty string.

      if (el instanceof HTMLTextAreaElement) {
        el.replaceChildren(val);
      } else if (el instanceof HTMLInputElement) {
        if (el.type === "checkbox") {
          el.checked = !["","false","off","0","null"].includes(val);
        } else {
          el.value = val;
        }
      } else if (el instanceof HTMLSelectElement && el.querySelector(`option[value="${val}"]`)) {
        el.value = val;
      }
    }
    // Part of honeypot handling.
    form.querySelector<HTMLInputElement>(".reqd > input")?.removeAttribute("value");

    // Process form on submission.
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (!form.dataset.action || !submitButton ||
        submitButton.ariaDisabled === "true" //prevent clicks during processing
      ) {
        return;
      }

      const errs: HTMLLIElement[] = [];
      const addErr = (text?: string, id?: string ) => {
        if (text) {
          const li = document.createElement('li');
          if (id) {
            const a = document.createElement('a');
            a.href = '#' + id;
            a.textContent = text;
            li.appendChild(a);
          } else {
            li.textContent = text;
          }
          errs.push(li);
        }
      };

      submitButton.ariaDisabled = "true";
      submitButton.dataset.state = "submitting";
      submitButton.focus(); //refocus on button to announce changed button text in screen reader

      const formData = new FormData(form);

      // Run captcha-specific preprocessing, if present.
      // If it returns an error, add it to error messages.
      const res = await window.ccc_org_base_captchaPreprocess?.(form, formData);
      addErr(res?.err, res?.id);

      // If the preprocess step didn't encounter any problems, run the form
      // handler and display the results.
      if (errs.length == 0) {
        // Send form data to handler, then wait for results.
        const response = await fetch(form.dataset.action, {
          method: 'POST',
          body: formData,
        });
        // don't call response.json() directly, will throw error if body is empty
        const text = await response.text();
        const result = text? JSON.parse(text) : {};
        
        for (const el of fields) {
          const errDest = el.dataset.err? document.getElementById(el.dataset.err) : undefined;
          const errText = el.dataset.name? (result.fields?.[el.dataset.name]?.join(", ")) : undefined;
          addErr(errText, el.id);
          el.ariaInvalid = errText? "true" : "false";
          errDest?.replaceChildren(errText);
        };

        if (!response.ok && errs.length == 0) {
          addErr(result.message?
            result.message 
            :
            "Network error, please try again later"
          );
        }
      }

      if (errs.length == 0) {
        form.reset();
        form.dataset.state = "success";
      } else {
        errList?.replaceChildren(...errs);
        form.dataset.state = "error";
      }
      msgContainer?.focus();
      //make sure to update the button AFTER the message container is focused,
      //to ensure we don't announce the change in button text.
      submitButton.ariaDisabled = "false";
      delete submitButton.dataset.state;

      // Refresh the captcha, to ensure that any additional submissions won't
      // try to reuse the same token.
      window.ccc_org_base_captchaRefresh?.();
    }); // END submit listener
  }); // END loop over forms
}
</script>


{/* Default styles for form control elements when used inside a Form. */}
<style is:global>
@layer base { .base-form {
  /*
    Add margin to every control that we might make a jump link point to, to
    prevent them from being flush up against the top of the screen when scrolled.
  */
  [id] {
    scroll-margin-top: 2lh;
  }

  input,textarea,.select {
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    transition: 120ms box-shadow ease-in-out;
    width: 100%;
    cursor: inherit;
    &:not(.select) {
      padding: 0.35em 1em;
    }
    
    &:hover, &:focus-visible, &:has(:focus-visible) {
      box-shadow: 0 0 0 1px var(--color-secondary-accent);
    }
  }

  /* For honeypot. */
  label.reqd {
    display: var(--toggle);
  }

  /* Default select styling. Requires wrapping the select in a div with a "select" class.
  * See: https://moderncss.dev/custom-select-styles-with-pure-css/
  */
  select {
    appearance: none;
    border: none;
    background-color: transparent;
    margin: 0;
    padding: 0.35em 2em 0.35em 1em;
    height: 100%;
    width: 100%;
    font-family: inherit;
    font-size: inherit;
    cursor: inherit;
    line-height: inherit;
    outline: none;
    box-shadow: none;

    option {
      background-color: var(--color-background);
    }

    &[multiple] {
      padding-right: 0;
      option {
        white-space: normal;
      }
    }
  }
  .select {
    position: relative;

    &:not(:has([multiple])) {
      &::after {
        position: absolute;
        pointer-events: none;
        top: 50%;
        right: 0.2em;
        transform: translateY(-50%);
        content: "";
        width: 0.8em;
        height: 0.5em;
        background-color: var(--color-secondary-foreground);
        transition: 120ms clip-path ease-in-out;
        clip-path: polygon(100% 0%, 0 0%, 50% 100%); /* triangle pointing down */
      }
      &:has(:open)::after {
        clip-path: polygon(100% 100%, 0% 100%, 50% 0%); /* triangle pointing up */
      }
    }
  }

  /* Also part of honeypot handling. */
  --toggle: none;

  /* Default checkbox/radio button styling.
    *  See: https://moderncss.dev/pure-css-custom-checkbox-style/
    *  See: https://moderncss.dev/pure-css-custom-styled-radio-buttons/
    */
  input {
    &[type="checkbox"],&[type="radio"] {
      appearance: none;
      background-color: transparent;
      margin: 0;
      padding: 0;
      width: 1lh;
      height: 1lh;
      display: grid;
      place-content: center;

      &:not(:disabled) {
        cursor: pointer;
      }

      &::before {
        content: "";
        width: 0.65lh;
        height: 0.65lh;
        transform: scale(0);
        box-shadow: inset 1lh 1lh currentcolor;
        background-color: CanvasText; /* for Windows High Contrast Mode */
        @media (prefers-reduced-motion: no-preference) {
          transition: 150ms transform ease-in-out;
        }
      }

      &:checked::before {
        transform: scale(1);
      }
    }
  
    &[type="checkbox"] {
      border-radius: var(--radius-sm);
      &::before {
        transform-origin: bottom left;
        clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%);
      }
    }

    &[type="radio"] {
      border-radius: 50%; 
      &::before {
        border-radius: 50%;
      }
    }
  }
}}
</style>