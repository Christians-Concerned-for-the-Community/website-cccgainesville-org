---
import { type HTMLAttributes } from "astro/types";

import { uniqueId } from "@base/utils/ids";

// Add the required CSP directives for Give Lively, but only on pages where
// the donation widget is actually present.
Astro.csp?.insertDirective("frame-src https://secure.givelively.org");

export interface Props extends HTMLAttributes<"form"> {
  /**
   * What amounts to suggest to the donor.
   * 
   * If not provided, an empty input box will be shown for the donor to type
   * their amount into.
   * 
   * If only one suggested amount is provided, the input box will be preset
   * to the given amount on load.
   * 
   * If more than one suggested amount is provided, an individual radio button
   * will be shown for each option, as well as a "Custom Amount" option that
   * shows the input box when clicked.
   * 
   * Default: no suggested amounts
   */
  suggestedAmounts?: number[],

  /**
   * Whether or not to let donors dedicate their gifts.
   * 
   * This places an extra button above submit that shows the dedication dialog
   * when clicked.
   * 
   * Default: false
   */
  doDedication?: boolean,

  /**
   * The slug that identifies your nonprofit.
   * 
   * If you want the donation widget to point at a campaign, the slug will
   * include that too.
   * 
   * For example, an org named "My Nifty Nonprofit, Inc." might have the following
   * URL when logging into Give Lively:
   *    secure.givelively/org/nonprofits/my-nifty-profit-inc
   * 
   * In this case, you'd want to set the slug to:
   *    my-nifty-nonprofit-inc
   */
  slug: string,

  /**
   * Locale to use for formatting strings.
   * 
   * Default: the locale of the server ("en-US", "de-DE", etc.)
   */
  locale?: string,

  /**
   * Currency code of the currency that donations will be made in.
   * 
   * Default: "USD"
   */
  currencyCode?: string,
};

const {
  suggestedAmounts,
  doDedication = false,
  slug,
  locale = new Intl.DateTimeFormat().resolvedOptions().locale,
  currencyCode = "USD",
  class: className,
  ...rest
} = Astro.props;

// Currency formatting stuff.
const settings: Intl.NumberFormatOptions = {
  style:"currency",
  currency:currencyCode,
  minimumFractionDigits: 0,
  maximumFractionDigits: 0,
};
const currencyFormatter = Intl.NumberFormat(locale, settings);
const currencyNameFormatter = Intl.NumberFormat(locale, {
  ...settings,
  currencyDisplay: "name"
});

const currencySymbol = currencyFormatter
  .formatToParts(2)
  .find(part => part.type === "currency")?.value || "$";
const currencyNamePlural = currencyNameFormatter
  .formatToParts(2)
  .find(part => part.type == "currency")?.value || "US dollars";


// Settings and id's for radio buttons and other inputs.
const frequencyButtons = [
  { title: "One-Time", value: "one-time", id: uniqueId(Astro.url, "gl-freq-onetime") },
  { title: "Monthly",  value: "monthly",  id: uniqueId(Astro.url, "gl-freq-monthly") }
];

const amountButtons = suggestedAmounts?.map(amount => { return {
  title: currencyFormatter.format(amount),
  alt: currencyNameFormatter.format(amount),
  value: String(amount),
  id: uniqueId(Astro.url, "gl-amt-" + amount),
}});
const hasAmountButtons = amountButtons && amountButtons.length > 1;
const otherAmountId = uniqueId(Astro.url, "gl-amt-other");
const otherAmountEntryId = uniqueId(Astro.url, "gl-amt-custom");

const dedicationButtons = [
  { title: "In Honor Of",  value: "InHonorOfDedication",  id: uniqueId(Astro.url, "gl-ded-honor") },
  { title: "In Memory Of", value: "InMemoryOfDedication", id: uniqueId(Astro.url, "gl-ded-memory") },
];

const alertIconId = uniqueId(Astro.url, "icon-warning");

const dedModalId = uniqueId(Astro.url, "gl-ded-modal");
const dedNameId = uniqueId(Astro.url, "gl-ded-name");
const dedEmailId = uniqueId(Astro.url, "gl-ded-email");

let defaultValue, defaultSuffix, defaultSuffixAlt;
if(!hasAmountButtons && amountButtons?.[0]) {
  defaultValue = amountButtons[0].value;
  defaultSuffix = currencyFormatter.format(defaultValue as unknown as number);
  defaultSuffixAlt = currencyNameFormatter.format(defaultValue as unknown as number);
}

---

<form novalidate data-slug={slug} data-locale={locale} data-currency={currencyCode}
  class:list={["gl-simple-donation-widget", className]}
  {...rest}
>
  {/* Gift Frequency */}
  <fieldset class="gl-focus-container">
    <legend class="sr-only">Donation Frequency</legend>
    { frequencyButtons.map((freq, idx) => (
    <label for={freq.id}>
      <input type="radio" id={freq.id} name="frequency" value={freq.value} checked={idx === 0} required/>
      {freq.title}
    </label>
    ))}
  </fieldset>

  {/* Gift Amount */}
  <div class="gl-err-group gl-amount">
    { hasAmountButtons && (
    <fieldset class="gl-focus-container">
      <legend class="sr-only">Donation Amount</legend>
      { amountButtons.map((amt) => (
      <label for={amt.id}>
        <input type="radio" id={amt.id} name="amount" value={amt.value} required/>
        <span aria-hidden="true">{amt.title}</span>
        <span class="sr-only">{amt.alt}</span>
      </label>
      ))}

      <label for={otherAmountId}>
        <input type="radio" id={otherAmountId} name="amount" value="other" required/>
        Custom Amount
      </label>
    </fieldset>
    )}

    <label for={otherAmountEntryId} class="gl-other-entry">
      <span class="gl-other-label-1 sr-only">Custom amount in {currencyNamePlural}:</span>
      <div class="gl-other-label-2">
        Donation amount<span class="sr-only"> in {currencyNamePlural}</span>:
      </div>
      <div class="gl-focus-container">
        <span aria-hidden="true">{currencySymbol}</span>
        <input type="text" id={otherAmountEntryId} inputmode="numeric" name="otherAmount" required={!hasAmountButtons}
          value={defaultValue}
        />
        <span aria-hidden="true">{currencyCode}</span>
      </div>
    </label>

    <div class="gl-err">
      <svg aria-hidden="true">
        <!-- https://tabler.io/icons?icon=alert-triangle -->
        <symbol id={alertIconId} viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M12 9v4" />
            <path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0" />
            <path d="M12 16h.01" />
          </g>
        </symbol>
        <use href={"#"+alertIconId}/>
      </svg>
      <span aria-live="polite"/>
    </div>
  </div>

  {/* Dedication Button and Modal */}
  {/*WIP*/ doDedication && (
  <button type="button" class="gl-ded-button gl-secondary" data-state="new" commandfor={dedModalId} command="show-modal">
    <svg aria-hidden="true" viewBox="0 0 24 24" stroke="currentColor">
      <!-- https://tabler.io/icons?icon=heart -->
      <path d="M6.979 3.074a6 6 0 0 1 4.988 1.425l.037 .033l.034 -.03a6 6 0 0 1 4.733 -1.44l.246 .036a6 6 0 0 1 3.364 10.008l-.18 .185l-.048 .041l-7.45 7.379a1 1 0 0 1 -1.313 .082l-.094 -.082l-7.493 -7.422a6 6 0 0 1 3.176 -10.215z" />
    </svg>
    <span class="gl-ded-button-new">Dedicate This Gift</span>
    <span class="gl-ded-button-edit">Edit Dedication</span>
  </button>

  <dialog id={dedModalId} class="gl-dedication-modal" closedby="any">
    <button type="button" class="gl-ded-close gl-ghost" commandfor={dedModalId} command="close">
      <svg aria-hidden="true" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6l-12 12" /><path d="M6 6l12 12" />
      </svg>
      <span class="sr-only">Close</span>
    </button>

    <form novalidate aria-label="Dedication">
      <fieldset class="gl-focus-container">
        <legend class="sr-only">Dedication Type</legend>

        { dedicationButtons.map((ded) => (
        <label for={ded.id}>
          <input type="radio" id={ded.id} name="amount" value={ded.value} required/>
          {ded.title}
        </label>
        ))}
      </fieldset>

      <div class="gl-err-group">
        <label for={dedNameId}>
          Dedicatee's Name
          <input id={dedNameId} type="text" autocomplete="name" spellcheck="false" autocapitalize="words" autocorrect="off" maxlength="255"/>
        </label>

        <div class="gl-err">
          <svg aria-hidden="true"><use href={"#"+alertIconId}/></svg>
          <span aria-live="polite"/>
        </div>
      </div>

      <div class="gl-err-group">
        <label for={dedEmailId}>
          Recipient Email
          <input id={dedEmailId} type="email" autocomplete="email" maxlength="255"/>
          <span>Notify someone about your gift. The email will identify you as the donor, but does not specify the amount of your gift.</span>
        </label>

        <div class="gl-err">
          <svg aria-hidden="true"><use href={"#"+alertIconId}/></svg>
          <span aria-live="polite"/>
        </div>
      </div>

      <button type="button" class="gl-ded-remove gl-secondary">Remove</button>

      <button type="submit" class="gl-ded-save gl-primary">Save</button>
    </form>
  </dialog>
  )}

  {/* Donate Button and Modal */}
  <button type="submit" class="gl-donate-button gl-primary">
    <span>Donate <span aria-hidden="true">{defaultSuffix}</span></span>
    <span class="sr-only">{defaultSuffixAlt}</span>
  </button>

  <dialog class="gl-donate-modal" closedby="any">
    <iframe allow="payment" src="about:blank"></iframe>
  </dialog>
</form>


<style is:global>
@layer components { form.gl-simple-donation-widget {
  /* Default settings, can be overriden by project settings. */
  --gl-color-fg: light-dark(#4A4A4A, #FFF);
  --gl-color-bg: light-dark(#FFF, #164046);
  --gl-color-accent: light-dark(#0CA1B3, #00CBBC);
  --gl-color-error: light-dark(#9f0712, #ff6467);
  --gl-color-focus: light-dark(#F2853A, #F9C727);
  --gl-radius: 0.5rem;
  --gl-spacing-2xs: 0.25em;
  --gl-spacing-xs: 0.5em;
  --gl-spacing-sm: 1em;
  --gl-spacing-md: 1.5em;
  --gl-duration: 120ms;
  @media (prefers-reduced-motion: reduce) {
    --gl-duration: 0ms;
  }
  --gl-section-shadow: 0 4px 6px -1px rgba(0 0 0 0.1), 0 2px 4px -2px rgba(0 0 0 0.1));

  --gl-button-shadow: 0px 4px 4px -2px color-mix(in oklch, var(--gl-color-accent), transparent 80%);
  --gl-color-checked: color-mix(in oklch, var(--gl-color-accent), transparent 95%);

  max-width: 40ch;
  width: 100%;
  font-family: Avenir, Montserrat, Corbel, 'URW Gothic', source-sans-pro, sans-serif; /* Geometric Humanist - modernfontstacks.com */
  font-size: 1rem;
  color: var(--gl-color-fg);
  background-color: var(--gl-color-bg);

  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  padding: var(--gl-spacing-sm);

  border-radius: var(--gl-radius);
  border: 2px solid var(--gl-color-accent);
  box-shadow: var(--gl-section-shadow);

  .sr-only { /* the standard visibly-hidden/sr-only class from Tailwind CSS. */
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border-width: 0;
  }

  svg {
    width: 1lh;
    height: 1lh;
  }

  label {
    cursor: pointer;
    justify-content: center;
    align-items: center;
    border: 1px solid var(--gl-color-accent);
    border-radius: var(--gl-radius);

    &:has(input:not([type="radio"])) {
      font-size: 1.06em;
      font-weight: 500;
      & > :is(input,.gl-focus-container) {
        font-weight: 400;
        margin-block-start: var(--gl-spacing-2xs);
      }
    }
  }

  /* Reset all input styles to undecorated. */
  input {
    appearance: none;
    border: none;
    box-shadow: none;
    outline: none;
  }

  button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1ch;
    cursor: pointer;
    width: 100%;
    transition: var(--gl-duration) background-color ease-in-out;
    padding-inline: var(--gl-spacing-sm);
    border-radius: 9999px; /* pill shape */
    font-size: 1.06em;
    font-weight: 500;

    & + & { /* space between buttons */
      margin-block-start: var(--gl-spacing-sm);
    }

    &.gl-primary {
      padding-block: var(--gl-spacing-sm);
      color: var(--gl-color-bg);
      border: none;

      background-color: var(--gl-color-fg);
      &:hover, &:focus-visible {
        background-color: color-mix(in oklch, var(--gl-color-fg), var(--gl-color-bg) 10%);
      }
    }

    &.gl-secondary {
      padding-block: var(--gl-spacing-2xs);
      color: var(--gl-color-fg);
      border: 3px solid color-mix(in oklch, var(--gl-color-fg), var(--gl-color-bg) 30%);

      background-color: var(--gl-color-bg);
      &:hover, &:focus-visible {
        background-color: var(--gl-color-checked);
      }
    }

    &.gl-ghost {
      padding-block: var(--gl-spacing-2xs);
      transition: var(--gl-duration) color ease-in-out;

      color: color-mix(in oklch, var(--gl-color-fg), var(--gl-color-bg) 30%);
      &:hover, &:focus-visible {
        color: color-mix(in oklch, var(--gl-color-fg), var(--gl-color-bg) 10%);
        background-color: var(--gl-color-checked);
      }
    }

    &.gl-ded-button {
      &[data-state="new"] {
        svg { fill: transparent; }
        .gl-ded-button-new { display: inline; }
        .gl-ded-button-edit { display: none; }
      }
      &[data-state="edit"] {
        svg { fill: currentColor; }
        .gl-ded-button-new { display: none; }
        .gl-ded-button-edit { display: inline; }
      }
    }

    &.gl-ded-close {
      font-size: 0.9em;
      padding: var(--gl-spacing-sm);
      margin-left: auto;
    }
  }

  /* Set spacing between any combination of fieldsets and error groups. */
  :is(fieldset, .gl-err-group) + :is(fieldset, .gl-err-group) {
    margin-block-start: var(--gl-spacing-md);
  }

  /* Set spacing between a fieldset/error group and a subsequent button (also the reverse). */
  :is(fieldset, .gl-err-group) + button,
  button + :is(fieldset, .gl-err-group) {
    margin-block-start: var(--gl-spacing-md);
  }

  /* Fieldset: a radio button group, where each radio button just looks like a regular button */
  fieldset {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: start;
    width: 100%;
    gap: var(--gl-spacing-xs); /* space button radio buttons, in both dimensions */

    /*
      Inputs in a fieldset are a radio button group.
      Hide the radio buttons completely, only show the label that wraps them - the
      user will be able to click on / keyboard focus the label instead.
    */
    input {
      padding: none;
      margin: none;
      width: 0;
      height: 0;
    }

    /*
      Style the labels that wrap each radio button.
     */
    label {
      display: flex;
      flex: 1 0 fit-content; /* don't shrink to fit text, grow to fill available space along row, use width of text content as basis */
      padding: var(--gl-spacing-xs);
      user-select: none; /* make text unselectable by user (since it functions as a button) */

      transition: var(--gl-duration) box-shadow background-color text-shadow ease-in-out;
      box-shadow: var(--gl-button-shadow);
      background-color: var(--gl-color-bg);
      &:has(:checked) {
        box-shadow: 0 0 0 2px var(--gl-color-accent);
        text-shadow: 0.1px 0 currentColor, -0.1px 0 currentColor; /* simulate a slight bold, without changing letter spacing or position*/
      }
      &:hover, &:has(:checked) {
        background-color: var(--gl-color-checked);
      }

      /* Specific styling for the "Custom Amount" radio button. */
      &:has([value="other"]) {
        flex-basis: 100%; /* Force custom button onto its own line. */

        &:has(:checked) {
          padding-block-end: 0;
          /* When checked, remove bottom border so we can combine seamlessly with the amount input field. */
          box-shadow:
            0 -2px 0 0 var(--gl-color-accent),
            -2px 0 0 0 var(--gl-color-accent),
            2px 0 0 0 var(--gl-color-accent);
          border-end-end-radius: 0;
          border-end-start-radius: 0;
          border-block-end-color: transparent;
        }
      }
    }
  }

  .gl-amount { /* Error group for amount input. */

    & > label { /* Custom amount input field. */
      width: 100%;
    
      /* Border around currency spans and the input box itself. */
      .gl-focus-container {
        display: flex;
        background-color: var(--gl-color-bg);
        align-items: center;
        border: 2px solid var(--gl-color-accent);
        border-radius: var(--gl-radius);
        width: 100%;
        padding: 0.35em 1em;
        gap: 0.35em;

        span { /* gray out the currency prefix and suffix */
          color: color-mix(in oklch, currentColor, transparent 20%);
        }

        input {
          width: 100%;
        }
      }

      /* If there's no fieldset right before this label, style it as a standalone input. */
      &:not(fieldset + label) {
        display: block;
        border: none;

        .gl-other-label-1 { display: none; }  /* turn off "Custom Amount:" sr-only text */
        .gl-other-label-2 { display: block; } /* turn on "Donation Amount: text */
      }
    }

    /* Custom amount input box, if it has a fieldset right before it (part of custom amount radio button). */
    & > fieldset + label {
      display: none;
      .gl-other-label-1 { display: inline; } /* turn on "Custom Amount:" sr-only text */
      .gl-other-label-2 { display: none; }   /* turn off "Donation Amount: text */
      padding: var(--gl-spacing-xs) var(--gl-spacing-sm);

      /* Set styles so that the label looks like part of the last button in the fieldset. */
      background-color: var(--gl-color-checked);
      
      box-shadow:
        0 2px 0 0 var(--gl-color-accent),
        -2px 0 0 0 var(--gl-color-accent),
        2px 0 0 0 var(--gl-color-accent);

      border-start-end-radius: 0;
      border-start-start-radius: 0;
      border-block-start-color: transparent;
    }
    /* Display the custom input box when the "Custom Amount" radio is selected. */
    & > fieldset:has(input[value="other"]:checked) + label {
      display: inline-flex;
    }
  }

  .gl-err-group {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    width: 100%;

    .gl-err {
      margin-block: var(--gl-spacing-2xs);
      width: 100%;
      text-align: center;
      font-size: 0.9em;
      color: var(--gl-color-error);

      svg {
        display: none;
        pointer-events: none;
        margin-inline-end: 0.25em;
      }
    }
    &:has([aria-invalid="true"]) .gl-err svg {
      display: inline;
    }
  }
  
  iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  dialog {
    --fade-duration: calc(var(--gl-duration) * 2);

    top: 50%;
    left: 50%;

    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-gutter: auto;
    height: 100%;
    max-height: 94svh;
    width: 100%;
    max-width: min(94svw, 500px);
    padding: 0;
    margin: 0;
    border-radius: var(--gl-radius);
    box-shadow: var(--gl-section-shadow);

    /* Animate dialog entrance/exit. */
    transition:
      transform var(--fade-duration) ease-out,
      opacity var(--fade-duration) ease-in,
      display var(--fade-duration) allow-discrete,
      overlay var(--fade-duration) allow-discrete;

    &::backdrop {
      transition:
        background-color var(--fade-duration) ease-in,
        backdrop-filter var(--fade-duration) ease-in,
        display var(--fade-duration) allow-discrete,
        overlay var(--fade-duration) allow-discrete;
    }

    &:not([open]) { /*step 3: on the way out */
      opacity: 0;
      transform: translate(-50%, -35%);
      &::backdrop {
        background-color: transparent;
        backdrop-filter: blur(0px);
      }
    }
    &[open] { /*step 2: open */
      opacity: 1;
      transform: translate(-50%, -50%);
      &::backdrop {
        background-color: rgb(0 0 0 / 60%);
        backdrop-filter: blur(8px);
      }
    }
    @starting-style { &[open] { /*step 1: on the way in */
      opacity: 0;
      transform: translate(-50%, -65%);
      &::backdrop {
        background-color: transparent;
        backdrop-filter: blur(0px);
      }
    }}
  }

  /* error ring */
  [aria-invalid="true"]:not(.gl-focus-container *), /* I have aria-invalid="true" and I'm not inside a focus container, OR */
  .gl-focus-container:has([aria-invalid="true"]) {  /* I'm a focus container and a descendant has aria-invalid="true" */
    outline: 3px solid var(--gl-color-error);
    outline-offset: 4px;
  }
}}
@layer theme { form.gl-simple-donation-widget {
  /* focus ring - define in theme layer (lowest priority in Tailwind) so it can be overridden easily by the embedding project */
  :focus-visible:not(.gl-focus-container *), /* I have focus-visible and I'm not within a focus container, OR */
  .gl-focus-container:has(:focus-visible) {  /* I'm a focus container and a descendant has focus-visible */
    outline: 0.1875rem solid var(--gl-color-focus);
    outline-offset: 0.25rem;
  }
}}
</style>


<script>
{
  const MIN_DONATION = 5;
  const MAX_DONATION = 100000;

  // See if we need polyfill to mimic <dialog closedBy="any"> behavior on unsupported browsers.
  //  Note: Safari is only major one not ready yet - support is still in tech preview as of 2026/06
  const supports_closedby = (document.createElement("dialog") as any).closedBy === "none";

  document.querySelectorAll<HTMLFormElement>(".gl-simple-donation-widget").forEach((form) => {
    const qs = (query: string) => form.querySelector(query) as HTMLElement | null;

    const customInput = qs(".gl-amount > label input") as HTMLInputElement | null;
    const amountSet = qs(".gl-amount fieldset");
    const amountErr = qs(".gl-amount span[aria-live]");

    const donateSuffix = qs(".gl-donate-button span[aria-hidden]");
    const donateSuffixAlt = qs(".gl-donate-button span.sr-only");
    
    const dedicationModal = qs(".gl-dedication-modal") as HTMLDialogElement | null;

    const paymentModal = qs(".gl-donate-modal") as HTMLDialogElement | null;
    const iframe = qs(".gl-donate-modal iframe") as HTMLIFrameElement | null;

    if (!customInput || !amountErr || !donateSuffix || !donateSuffixAlt || !paymentModal || !iframe) {
      return;
    }

    const iframeUrl = new URL(`https://secure.givelively.org/donate/${form.dataset.slug}`);
    const thisUrl = new URL(document.URL);

    const locale = form.dataset.locale;
    const settings: Intl.NumberFormatOptions = {
      style: "currency",
      currency: form.dataset.currency,
      minimumFractionDigits: 0,
      maximumFractionDigits: 0,
    };
    const currencyFormatter = Intl.NumberFormat(locale, settings);
    const currencyNameFormatter = Intl.NumberFormat(locale, {
      ...settings,
      currencyDisplay: "name"
    });

    // Helper utils.
    const updateAmountError = (msg?: string | null, culprit?: HTMLElement | null): void => {
      /* calling postError() wiath an empty message resets to no-error state. */
      amountErr.replaceChildren(...(msg? [msg] : []));
      [amountSet, customInput].forEach( elem => {
        if (elem) {
          const isErr = msg && elem === culprit;
          elem.ariaInvalid = isErr? "true" : null;
          elem.ariaDescribedByElements = isErr? [amountErr] : null;
        }
      });
    };

    const updateDonateButton = (): void => {
      // Update donate button label based on currently selected amount and frequency.
      const formData = new FormData(form);
      const [amountStr] = getAmountDigits(formData);

      const freq = (formData.get("frequency") === "monthly")? " Monthly" : "";

      donateSuffix.replaceChildren(...(
        amountStr? [currencyFormatter.format(amountStr as unknown as number) + freq] : []
      ));

      donateSuffixAlt.replaceChildren(...(
        amountStr? [currencyNameFormatter.format(amountStr as unknown as number) + freq] : []
      ));
    };

    const getAmountDigits = (formData: FormData): [string | null | undefined, boolean] => {
      const buttonSelection = formData.get("amount") as string | null;
      const customInput = formData.get("otherAmount") as string | null;
      const ret: [string | null | undefined, boolean] = (!amountSet || buttonSelection === "other")?
        [customInput, true] : [buttonSelection, false];
      ret[0] = ret[0]?.replace(/\D/g, "");
      return ret;
    };

    // Polyfill to mimic <dialog closedBy="any"> behavior on unsupported browsers.
    if (!supports_closedby) {
      [paymentModal, dedicationModal].forEach(modal => modal?.addEventListener('click', (e) => {
        const edges = modal.getBoundingClientRect();
        if (e.clientX < edges.left || e.clientX > edges.right ||
            e.clientY < edges.top  || e.clientY > edges.bottom) {
          e.preventDefault();
          modal.close();
        }
      }));
    }

    // When any fields in the form are modified: update submit button text to reflect chosen donation amount
    form.addEventListener('input', () => updateDonateButton());

    // When the amount button selection is changed: clear all current errors.
    amountSet?.addEventListener("change", () => updateAmountError());

    // When the custom amount is edited:
    customInput.addEventListener('input', () => {
      // Reformat number for current locale as currency, but remove the currency symbol (since it's already included in prefix).
      if (customInput.value) {
        const digits = customInput.value.replace(/\D/g, "");
        customInput.value = digits?
          currencyFormatter.formatToParts(digits as unknown as number)
            .flatMap((part) => part.type === "currency"? [] : [part.value]).join("").trim()
          :
          ""
        ;
      }
    });
    customInput.addEventListener('beforeinput', (e) => {
      // Prevent user from manually entering any non-digit characters.
      if (e.data && /\D/g.test(e.data)) {
        e.preventDefault();
      }
    });

    // When the iframe sends out a message:
    window.addEventListener('message', (e: MessageEvent) => {
      if (e.origin !== iframeUrl.origin) return; //make sure messages are coming from givelively's origin, for security

      const message = ((typeof e.data === "object")?
        (e.data?.message || JSON.stringify(e.data))
        :
        String(e.data)
      ).toLowerCase();

      // Reset the form if the user's donation succeeded.
      if (message.includes("gl_checkout_complete")) {
        form.reset();
        updateDonateButton(); // needed because events aren't fired when form values are changed programmatically.
      }

      // Close the modal window if the user asked the iframe to close.
      if (message === "close_modal" && paymentModal?.open) {
        paymentModal.close();
      }
    });

    // When donation modal is closed:
    paymentModal.addEventListener('close', () => {
      // Clear out the iframe.
      iframe.setAttribute('src', 'about:blank');
    });

    // When donate button is pressed:
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();

      // Get user selections from form.
      const formData = new FormData(form);

      const frequency = formData.get("frequency") as string | null;

      const [amountStr, isCustom] = getAmountDigits(formData);
      const amount = Number(amountStr) || 0;

      // Validate user selections.
      let errMsg;
      if (!isCustom && amount == 0) {
        errMsg = "Select a donation amount.";
      } else if (amount < MIN_DONATION) {
        errMsg = `Enter a donation of ${currencyFormatter.format(MIN_DONATION)} or more.`;
      } else if (amount > MAX_DONATION) {
        errMsg = `Enter a donation of ${currencyFormatter.format(MAX_DONATION)} or less.`;
      }
      updateAmountError(errMsg, (isCustom? customInput : amountSet)); // clears err state if errMsg is falsy
      if (errMsg) {
        return;
      }

      // Construct query params to pass to the iframe.
      const params = new URLSearchParams({
        recurring: String(frequency === "monthly"),
        override_amount: amountStr || "",
        dedication_name: (formData.get("ded_name") as string | null) || "",
        dedication_email: (formData.get("ded_email") as string | null) || "",
        dedication_type: (formData.get("ded_type") as string | null) || "",
        widget_type: "simple_donation",
        widget_url: thisUrl.origin + thisUrl.pathname,
        isWixEmbedded: "false",
      });
      if (document.referrer) {
        params.set("referrer_url", document.referrer);
      }
      const utm_source = new URLSearchParams(thisUrl.search).get("utm_source");
      if (utm_source) {
        params.set("utm_source", utm_source);
      }

      // Set the iframe URL. Show modal window immediately.
      iframeUrl.search = params.toString();
      iframe.setAttribute("src", iframeUrl.toString());
      paymentModal.showModal();
    });
  });
}
</script>
