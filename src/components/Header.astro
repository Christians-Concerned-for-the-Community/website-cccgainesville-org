---
import Nav from "@base/Nav.astro"
import Icon from "@base/Icon.astro"
import SkipLink from "@base/SkipLink.astro"

import nav from '@/assets/nav.json'
import socials from '@/assets/socials.json'


---
<header class:list={[
  "text-lg py-md bg-background/80 max-sm:backdrop-blur-lg",
  "[view-transition-name:header] [view-transition-class:base-same-only]",
]}>
  
  {/* Skip Link (hidden, but becomes visible when focused by pressing "tab" key) */}
  <SkipLink targetId="#main-content"/>

  {/* Navigation bar on wide screens, disappearing side nav panel on narrow screens. */}
  <Nav links={nav} icons={socials} maxVisibleLinks={5}
    class="max-w-(--content-max) px-3xs">

    {/* Logo / Home Link */}
    <a href="/" class:list={["hocus:bg-muted active:bg-muted-dark",
      "duration-200 transition-[background-color]"
    ]}>
      <Icon name="ccc-logo-wide" width="100%" height="100%"
        class="block aspect-4/1 text-foreground"
      />
      <span class="sr-only">Home - Christians Concerned for the Community</span>
    </a>

  </Nav>
</header>