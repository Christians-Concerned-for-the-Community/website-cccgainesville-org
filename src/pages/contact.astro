---
import PageLayout from '@/layouts/PageLayout.astro'

import Link from '@base/Link.astro';
import Button from '@base/Button.astro';
import Icon from '@base/Icon.astro';

import ContactForm from '@/components/forms/ContactForm.astro'

import contactInfo from "@/assets/contact-info.json";

import feat from '@/assets/media/contact-feat.jpg'

const emailLink = `mailto:${contactInfo.email}`;
const phoneLink = `tel:+1${contactInfo.phone?.split("ext")[0].replace(/\D/g, "").slice(-10)}`;

---

<PageLayout title="Contact" subtitle="Have a question? Get in touch with us!" featuredImage={feat}
  profile={["captcha"]},
  class="grid grid-cols-1 gap-xl md:gap-3xl md:grid-cols-2"
>
  {/* Contact Form  */}
  <section>
    <h2 class="sr-only">Contact Form</h2>
    <ContactForm />
  </section>

  {/* Info Section */}
  <section class="space-y-md">
    <h2 class="text-h3 mb-md">Hi there, neighbor</h2>

    <p>
      Whether you're looking for furnishings, need a ramp built, or just have a question,
      we'd love to hear from you. Please make sure to give us good contact info so we can
      follow up.
    </p>
    <p>
      If you contact us outside of office hours (see below), we might not be able to get
      back to you until we've returned to our desks. Sorry!
    </p>

    { contactInfo.phone && (
    <div class="gap-2xs flex items-center">
      <Icon name="tabler:phone" size="1lh" />
      <p>
        <span class="font-bold">Phone:</span>
        <Link href={phoneLink}>{contactInfo.phone}</Link>
        <span>(voice or text)</span>
      </p>
    </div>
    )}

    { contactInfo.email && (
    <div class="gap-2xs flex items-center">
      <Icon name="tabler:mail" size="1lh" />
      <p>
        <span class="font-bold">Email:</span>
        <Link href={emailLink}>{contactInfo.email}</Link>
      </p>
    </div>
    )}

    { contactInfo.address && (
    <div class="gap-2xs flex items-center">
      <Icon name="tabler:map-pin" size="1lh" />
      <p>
        <span class="font-bold">Address:</span>
        {contactInfo.address}
      </p>
    </div>
    )}

    { contactInfo.hours && (
    <div class="gap-2xs flex items-center">
      <Icon name="tabler:clock" size="1lh" />
      <p>
        <span class="font-bold">Office Hours:</span>
        {contactInfo.hours}
      </p>
    </div>
    )}

    <ul class="flex flex-wrap gap-md text-lg">
      <li>
        <Button
          icon="facebook"
          href="https://facebook.com/cccgainesville"
          animation="raise-boop"
          alt="Go to our Facebook page"
        />
      </li>
      <li>
        <Button
          icon="instagram"
          href="https://instagram.com/cccmainoffice"
          animation="raise-boop"
          alt="Go to our Instagram page"
        />
      </li>
      <li>
        <Button
          label="Newsletter Signup"
          iconBefore="tabler:mail-plus"
          href="https://cccgainesville.org/ns"
          variant="secondary"
          animation="raise-boop"
        />
      </li>
    </ul>
  </section>
</PageLayout>
