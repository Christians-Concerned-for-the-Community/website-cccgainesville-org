---
import PageLayout from '@/layouts/PageLayout.astro'
import GiveLively from '@/components/givelively/GiveLively.astro'
import Feat from '@/assets/media/give-feat.jpg'
---

<PageLayout title="Give" subtitle="Help us serve our community." featuredImage={Feat}
  profile={["givelively"]}
  class="flex flex-col gap-xl-2xl items-center"
>
  <div class="grid grid-cols-1 gap-xl md:gap-2xl md:grid-cols-2">
    {/* Donation Form */}
    <section class="flex items-center justify-center md:justify-end justify-self-center md:justify-self-end-safe w-full">
      <h2 class="sr-only">Donation Form</h2>
      <GiveLively slug="christians-concerned-for-the-community-inc"
        suggestedAmounts={[100,250,500,1000]},
        suggestedRecurringAmounts={[25,50,100,250]},
        doDedication={true},
        class:list={[
          "font-[inherit] text-base 3xs:text-base-2xl md:text-base grow",
          "border-0 border-t-3 border-t-foreground rounded-sm shadow-md",
          "dark:border-muted dark:border-2",
      ]}/>
    </section>

    {/* Form Instructions */}
    <section class="justify-self-start space-y-md max-w-[60ch]">
      <h2 class="text-h3 mb-md">Partner with Us!</h2>

      <p>
        Support CCC's service to our neighbors by filling out this secure form.
        You'll be able to make an immediate gift from one of the following sources:
      </p>
      <ul class="text">
        <li><span class="font-medium">Bank account</span> &nbsp;(preferred - lowest costs)</li>
        <li>Credit/debit card</li>
        <li>Paypal</li>
        <li>Venmo</li>
        <li>Donor-advised fund transfer</li>
      </ul>
    </section>
  </div>

  {/* Other Ways to Give */}
  <section class = "space-y-md max-w-[60ch] self-start md:self-center-safe">
    <h2 class="text-h3">Other ways to give</h2>
    <p>
      Physical checks may be sent to our mailing address:
    </p>
    <p class="inset">
      Christians Concerned for the Community<br>
      P.O. Box 358173<br>
      Gainesville, FL 32635
    </p>
  </section>
</PageLayout>

<style is:global>
  /* Settings overrides for the give lively widget. */
  .gl-simple-donation-widget {
    --gl-color-fg: var(--color-foreground);
    --gl-color-bg: var(--color-background);
    --gl-color-accent: var(--color-border-strong);
    --gl-color-error: var(--color-error);
    --gl-color-focus: transparent;
    --gl-spacing-2xs: var(--spacing-2xs);
    --gl-spacing-xs: var(--spacing-xs);
    --gl-spacing-sm: var(--spacing-sm);
    --gl-spacing-md: var(--spacing-md);
  }
</style>
