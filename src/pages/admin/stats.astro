---
/**
 * This dashboard was vendored in from here: https://github.com/abhishekhsingh/goatcounter-dashboard
 *
 * It was lightly modified to allow substituting in the endpoint (baseURL) and token (apiKey) using
 * data attributes on the document root, so the user doesn't have to log in.
 *
 * This file subs the endpoint and token in by doing a regex replace on a couple placeholders we added
 * to the original HTML file.
 */

import { getSecret } from "astro:env/server";

// Server-render the stats page, so we can access server-side secrets.
// Note: access to this path will be behind Google Auth using Cloudflare One Access, so it's okay
//       that this secret winds up visible to the client.
export const prerender = false;

// Get endpoint and token values.
let endpoint = process.env.PUBLIC_GOATCOUNTER_ENDPOINT;
if (!endpoint.endsWith("/")) {
  endpoint += "/";
}
const token = getSecret("SECRET_GOATCOUNTER_VIEWTOKEN") || "";

// Get the HTML of the dashboard, replace our placeholders with the actual endpoint and token.
// Note: each placeholder only appears once, very near to the top of the file, so it's more efficient
//       to chain two single replaces than to do a global replace with a regex.
import htmlString from '/src/assets/gc-dashboard.html?raw';
const replacedHtmlString = htmlString
  .replace("{{{ENDPOINT}}}", endpoint)
  .replace("{{{TOKEN}}}", token);

// Tell CDN to cache the response, and only re-render the page once every five minutes at most.
// This puts an upper limit on the number of times per day we'll actually have to generate this page.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=30');
---
<Fragment set:html={replacedHtmlString} />