---
/**
 * Use Sveltia CMS to provide a client-side interface to edit the website.
 * 
 * Config is embedded in the script command below, instead of using a separate
 * config.yaml file.
 */

import { getSecret } from "astro:env/server";

export const prerender = false;

let token: string | undefined = undefined;
const email = Astro.request.headers.get("Cf-Access-Authenticated-User-Email");
if (email) {
  /*
    Map authenticated email to stored GitHub personal-access tokens.
    Unlisted emails default to using the office account's PAT.

    This isn't for security - we've already got the editor locked behind Cloudflare
    Access. It's to allow us to provide auto-logins, while still being able to
    keep track of which staff member authored each edit.
   */
  const keymap = new Map([
    ["michael@cccgainesville.org", "SECRET_GITHUB_DIRECTOR"],

    ["stephen.sorley@cccgainesville.org", "SECRET_GITHUB_ADMIN"],
    ["stephen.sorley@gmail.com", "SECRET_GITHUB_ADMIN"],
    ["swirley161@gmail.com", "SECRET_GITHUB_ADMIN"],
  ]);
  token = getSecret(keymap.get(email.toLowerCase()) ?? "SECRET_GITHUB_OFFICE");
}
// If we're running locally in dev or preview mode, there won't be an authenticated
// user email set. In that case, just let the dev log in with a PAT manually.

---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />

    <title>Site Editor - Christians Concerned for the Community</title>
  </head>
  <body>
    <div data-token={token}/>
    <script>
import { init, type CmsConfig } from '@sveltia/cms';
{
  // If we have a Github PAT available to use, store it in localStorage where
  // Sveltia puts its session data. This lets us log in without user interaction,
  // using the PAT.
  const token = document.querySelector<HTMLElement>("[data-token]")?.dataset.token;
  if (token) {
    const userKey = "sveltia-cms.user";
    const userVal = localStorage.getItem(userKey);

    const user: Record<string,any> = userVal? JSON.parse(userVal) : {};
    user.backendName = "github";
    user.token = token;

    localStorage.setItem(userKey, JSON.stringify(user));
  }

  const config: CmsConfig = {
    load_config_file: false,

    app_title: "CCC Website Editor",
    site_url: location.hostname,
    logo: {
      src: '/favicon.svg',
      show_in_header: true,
    },

    backend: {
      name: "github",
      repo: "Christians-Concerned-for-the-Community/website-cccgainesville-org",
    },

    media_folder: "src/assets/media",
  };

  config.collections = [{
    name: "config",
    label: "Site Configuration",
    editor: { preview: false },
    files: [
      
      {
        label: "Headers",
        name: "headers",
        file: "public/_headers",
        format: "raw",
        fields: [{
          label: "Headers",
          name: "body",
          widget: "text",
        }],
      },

      {
        label: "Redirects",
        name: "redirects",
        file: "public/_redirects",
        format: "raw",
        fields: [{
          label: "Redirects",
          name: "body",
          widget: "text",
        }],
      },

    ],
  }];

  init({config: config});
}
    </script>
  </body>
</html>