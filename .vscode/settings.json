{
    "editor.quickSuggestions": {
        "strings": "on"
    },
    "files.associations": {
        "*.css": "tailwindcss"
    },
    "editor.tabSize": 2,
    "tailwindCSS.experimental.classRegex": [
        "\\w*[cC]lass\\s*=\\s*\"([^\"]*)\"",
        "\\w*[cC]lass\\s*=\\s*'([^']*)'",
        ["tv\\({([^]*?)}\\)", "[\"'`]([^\"'`]*)[\"'`]"],
        ["(?:twMerge|twJoin)\\(([^;]*)[\\);]", "[`'\"`]([^'\"`;]*)[`'\"`]"],
    ],
}