{
  "name": "website-cccgainesville-org",
  "description": "Main website for Christians Concerned for the Community",
  "version": "0.1.0",
  "type": "module",
  "browserslist": [
    "baseline widely available"
  ],
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "preview": "wrangler types && astro build && astro preview",
    "build": "wrangler types && astro build",
    "build-production": "CLOUDFLARE_ENV=production sh -c 'wrangler types && astro build'",
    "deploy": "wrangler deploy --env=''",
    "deploy-production": "CLOUDFLARE_ENV=production wrangler deploy",
    "generate-types": "wrangler types",
    "postinstall": "pnpm up --depth=Infinity --no-save caniuse-lite baseline-browser-mapping"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.7.0",
    "lightningcss": "^1.32.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.3",
    "@astrojs/sitemap": "^3.7.3",
    "@sveltia/cms": "^0.172.1",
    "@tabler/icons": "^3.45.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.1",
    "browserslist-to-esbuild": "^2.1.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "wrangler": "^4.112.0"
  }
}
