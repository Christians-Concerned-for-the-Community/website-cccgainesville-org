{
  "name": "website-cccgainesville-org",
  "description": "Main website for Christians Concerned for the Community",
  "version": "0.1.0",
  "type": "module",
  "browserslist": [
    "baseline widely available"
  ],
  "scripts": {
    "dev": "CLOUDFLARE_ENV=development astro dev",
    "build": "wrangler types && astro build",
    "preview": "CLOUDFLARE_ENV=development sh -c 'wrangler types && astro build && astro preview'",
    "astro": "astro",
    "deploy": "wrangler deploy --env=''",
    "deploy-production": "wrangler deploy --env='production'",
    "generate-types": "wrangler types",
    "postinstall": "pnpm up --depth=Infinity --no-save caniuse-lite baseline-browser-mapping"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.3.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.6.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.0",
    "@astrojs/sitemap": "^3.7.2",
    "@tabler/icons": "^3.44.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.1",
    "browserslist-to-esbuild": "^2.1.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "wrangler": "^4.90.0"
  }
}
